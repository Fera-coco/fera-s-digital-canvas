{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/concepts/brightdoor",
      "destination": "/concepts/brightdoor/"
    },
    {
      "source": "/concepts/brightdoor/:path*",
      "destination": "/concepts/brightdoor/"
    },
    {
      "source": "/demos/superb-naturals",
      "destination": "/demos/superb-naturals/"
    },
    {
      "source": "/demos/superb-naturals/:path*",
      "destination": "/demos/superb-naturals/"
    },
    {
      "source": "/demos/superb-naturals-classic",
      "destination": "/demos/superb-naturals-classic/"
    },
    {
      "source": "/demos/superb-naturals-classic/:path*",
      "destination": "/demos/superb-naturals-classic/"
    },
    {
      "source": "/demos/wogvintage-hub",
      "destination": "/demos/wogvintage-hub/"
    },
    {
      "source": "/demos/wogvintage-hub/:path*",
      "destination": "/demos/wogvintage-hub/"
    },
    {
      "source": "/demos/wogvintage-hub-blue",
      "destination": "/demos/wogvintage-hub-blue/"
    },
    {
      "source": "/demos/wogvintage-hub-blue/:path*",
      "destination": "/demos/wogvintage-hub-blue/"
    },
    {
      "source": "/((?!api/)(?!concepts/)(?!demos/)(?!.*\\.).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/open-call/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
